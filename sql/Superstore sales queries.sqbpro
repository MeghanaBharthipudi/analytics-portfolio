-- Build an RFM Segmentation Analysis with Customer Risk Profile
select *,
lag(OrderDate) over (PARTITION by CustomerName order by OrderDate asc) as prev_order_date,
cast((julianday(OrderDate) - julianday(lag(OrderDate) over (PARTITION by CustomerName order by OrderDate asc))) as int) as recency
FROM(
SELECT CustomerName,substr(max(OrderDate),7,4) || '-' || substr(max(OrderDate),4,2) || '-' || substr(max(OrderDate),1,2) as OrderDate,Sum(CAST(replace(replace(Sales,'$',''),',','') as float)) as OrderSalesAmount,
rank() over (partition by CustomerID order by substr(OrderDate,7,4) || '-' || substr(OrderDate,4,2) || '-' || substr(OrderDate,1,2) asc) as Order_Sequence_Number
FROM [Superstore Sales Dataset]
GROUP BY CustomerID,CustomerName,OrderDate)








