-- SELECT 
--     substr([Month&amp;YearOrder],-4) as Year, 
--     SUM(CAST(REPLACE(REPLACE([Sales],',',''),'$','') AS FLOAT)) as Total_Sales,
--     COUNT(DISTINCT [OrderID]) as Total_Orders,
-- 	LAG(SUM(CAST(REPLACE(REPLACE([Sales],',',''),'$','') AS FLOAT))) OVER (ORDER BY substr([Month&amp;YearOrder],-4)) as Prior_Year_sales,
-- 	LEAD(SUM(CAST(REPLACE(REPLACE([Sales],',',''),'$','') AS FLOAT))) OVER (ORDER BY substr([Month&amp;YearOrder],-4)) as Next_Year_sales,
-- 	(SUM(CAST(REPLACE(REPLACE([Sales],',',''),'$','') AS FLOAT)) - LAG(SUM(CAST(REPLACE(REPLACE([Sales],',',''),'$','') AS FLOAT))) OVER (ORDER BY substr([Month&amp;YearOrder],-4)))/LAG(SUM(CAST(REPLACE(REPLACE([Sales],',',''),'$','') AS FLOAT))) OVER (ORDER BY substr([Month&amp;YearOrder],-4))*100 as YoY
-- FROM [Superstore Sales dataset]
-- GROUP BY Year
-- ORDER BY Total_Sales DESC;

-- Top 10 Customers
-- SELECT
--     CustomerID, CustomerName,
-- 	Rank() Over(Order By SUM(CAST(REPLACE(REPLACE([Sales],',',''),'$','') AS FLOAT)) desc) as 'rank',
-- 	SUM(CAST(REPLACE(REPLACE([Sales],',',''),'$','') AS FLOAT)) as Total_Sales,
-- 	COUNT(DISTINCT [OrderID]) as Total_Orders,
-- 	Segment
-- FROM [Superstore Sales dataset]
-- GROUP by CustomerID, CustomerName, Segment
-- Limit 10

-- Timeline Analysis
-- SELECT CustomerID, CustomerName, substr(max(OrderDate),7,4) || '-' || substr(max(OrderDate),4,2) || '-' || substr(max(OrderDate),1,2) as Last_Purchase, CURRENT_DATE,cast((julianday(current_date) - julianday(substr(max(OrderDate),7,4) || '-' || substr(max(OrderDate),4,2) || '-' || substr(max(OrderDate),1,2))) as int) as ageing, sum(cast(replace(replace([Sales],'$',''),',','') as float)) as Total_Sales, count(distinct OrderId) as Total_Orders
-- FROM [Superstore Sales dataset]
-- group by CustomerID, CustomerName
-- order by cast((julianday(current_date) - julianday(substr(max(OrderDate),7,4) || '-' || substr(max(OrderDate),4,2) || '-' || substr(max(OrderDate),1,2))) as int)

-- Monthly Sales Trend with Moving Average
-- select SUM(CAST(REPLACE(REPLACE([Sales],',',''),'$','') AS FLOAT)) as Total_Sales, substr(OrderDate,7,4) || '-' || substr(OrderDate,4,2) as MonYear,
-- lag(SUM(CAST(REPLACE(REPLACE([Sales],',',''),'$','') AS FLOAT))) Over (Order by substr(OrderDate,7,4) || '-' || substr(OrderDate,4,2)) as prev_mon,
-- avg(SUM(CAST(REPLACE(REPLACE([Sales],',',''),'$','') AS FLOAT))) Over (Order by substr(OrderDate,7,4) || '-' || substr(OrderDate,4,2) Rows BETWEEN 2 PRECEDING and CURRENT Row) as Moving_Avg
-- FROM [Superstore Sales dataset]
-- group by substr(OrderDate,7,4) || '-' || substr(OrderDate,4,2)
-- order by substr(OrderDate,7,4) || '-' || substr(OrderDate,4,2) asc

-- Anamolies in Orders
-- select *
-- from(
-- select OrderID, CustomerName, SUM(CAST(REPLACE(REPLACE([Sales],',',''),'$','') AS FLOAT)) as Total_Order, percent_rank() Over (order by SUM(CAST(REPLACE(REPLACE([Sales],',',''),'$','') AS FLOAT)) asc) as 'percentage'
-- FROM [Superstore Sales dataset]
-- group by OrderID
-- )
-- where percentage &gt;= 0.95
-- order by percentage desc
-- Limit 10

-- RFM segments for each customer
select *, CASE 
        WHEN Recency_Days &lt; 100 AND Frequency &gt; 10 AND Monetary_Value &gt; 100000 THEN 'VIP'
        WHEN Recency_Days &lt; 180 AND Frequency &gt; 5 AND Monetary_Value &gt; 50000 THEN 'Loyal'
        WHEN Recency_Days &gt; 365 THEN 'Dormant'
        ELSE 'Standard'
    END as RFM_Segment
from	
(SELECT 
    CustomerID, 
    CustomerName,
    CAST((julianday(current_date) - julianday(substr(max(OrderDate),7,4) || '-' || substr(max(OrderDate),4,2) || '-' || substr(max(OrderDate),1,2))) AS INT) as Recency_Days, 
    COUNT(DISTINCT OrderId) as Frequency,
    SUM(CAST(REPLACE(REPLACE([Sales],'$',''),',','') AS FLOAT)) as Monetary_Value
FROM [Superstore Sales dataset]
GROUP BY CustomerID, CustomerName
ORDER BY Monetary_Value DESC)
Limit 20;




</sql><current_tab id="0"/></tab_sql></sqlb_project>
